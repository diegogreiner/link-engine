NODE_ENV=development
PORT=3000
APP_VERSION=development
LOG_LEVEL=info

# PostgreSQL / Neon. Use a pooled URL (-pooler) for the running application.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=replace-with-a-strong-password

# Exact browser origins, separated by commas. Never use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3001
# Optional constraints for authorized preview hosts. Both values are required.
CORS_PREVIEW_HOST_PREFIX=
CORS_PREVIEW_HOST_SUFFIX=
TRUST_PROXY_HOPS=1

# HMAC secret. Rotation breaks correlation with hashes generated previously.
IP_HASH_SECRET=replace-with-a-dedicated-32-character-secret
IP_HASH_RETENTION_DAYS=30

# Error monitoring is disabled when SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
