  "info": {
    "title": "Link Engine API",
    "description": "API para criação de links curtos, redirecionamento e consulta de analytics.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Cadastro, autenticação e sessões"
    },
    {
      "name": "Links",
      "description": "Criação e gestão de links curtos"
    },
    {
      "name": "Analytics",
      "description": "Métricas dos links do usuário"
    },
    {
      "name": "Redirect",
      "description": "Redirecionamento público de links curtos"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desenvolvimento local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token obtido em /auth/login"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "teste@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "minha senha 1234@"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT usado nas rotas privadas"
          },
          "refreshToken": {
            "type": "string",
            "description": "JWT usado para renovar a sessão"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "email"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string",
                "example": "Requisição inválida"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "email must be an email"
                ]
              }
            ]
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "teste@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "minha senha 1234@"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokensResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT usado nas rotas privadas"
          },
          "refreshToken": {
            "type": "string",
            "description": "JWT usado para renovar a sessão"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token emitido no login ou cadastro"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MessageResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Operação realizada com sucesso"
          }
        },
        "required": [
          "message"
        ]
      },
      "CreateLinkDto": {
        "type": "object",
        "properties": {
          "originalUrl": {
            "type": "string",
            "example": "https://google.com"
          },
          "expiresAt": {
            "type": "string",
            "example": "2025-12-31"
          },
          "ga4MeasurementId": {
            "type": "string",
            "example": "G-XXXXXXXXXX"
          }
        },
        "required": [
          "originalUrl"
        ]
      },
      "CreatedLinkResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "originalUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/artigo"
          },
          "shortCode": {
            "type": "string",
            "example": "aB3xYz"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "ga4MeasurementId": {
            "type": "string",
            "example": "G-XXXXXXXXXX",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
