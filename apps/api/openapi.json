            "type": "string",
            "example": "https://google.com"
          },
          "expiresAt": {
            "type": "string",
            "example": "2025-12-31"
          },
          "ga4MeasurementId": {
            "type": "string",
            "example": "G-XXXXXXXXXX"
          }
        }
      },
      "LinkResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "originalUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/artigo"
          },
          "shortCode": {
            "type": "string",
            "example": "aB3xYz"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "ga4MeasurementId": {
            "type": "string",
            "example": "G-XXXXXXXXXX",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "clicks": {
            "type": "number",
            "example": 42,
            "minimum": 0
          }
        },
        "required": [
