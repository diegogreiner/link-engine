          "originalUrl",
          "shortCode",
          "expiresAt",
          "ga4MeasurementId",
          "createdAt",
          "updatedAt",
          "userId",
          "clicks"
        ]
      },
      "LinkListItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "originalUrl": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/artigo"
