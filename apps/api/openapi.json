        "operationId": "AnalyticsController_getClicksPerDay",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID do link",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Primeiro dia do período, inclusivo, no fuso America/Sao_Paulo",
            "schema": {
              "example": "2026-08-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "Último dia do período, inclusivo, no fuso America/Sao_Paulo",
