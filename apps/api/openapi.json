          "originalUrl",
          "shortCode",
          "createdAt",
          "expiresAt",
          "ga4MeasurementId",
          "clicks"
        ]
      },
      "AnalyticsSummaryResponseDto": {
        "type": "object",
        "properties": {
          "totalClicks": {
            "type": "number",
            "example": 120,
            "minimum": 0
          },
          "totalClicksToday": {
            "type": "number",
            "example": 8,
            "minimum": 0
          },
          "mostAccessedLink": {
            "type": "object",
            "nullable": true,
            "required": [
              "id",
              "shortCode",
              "originalUrl",
              "totalClicks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "shortCode": {
                "type": "string",
                "example": "aB3xYz"
              },
              "originalUrl": {
                "type": "string",
                "format": "uri"
              },
              "totalClicks": {
                "type": "number",
                "example": 42,
                "minimum": 0
              }
            }
          }
        },
        "required": [
